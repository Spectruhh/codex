+'use client';
+
+import { FormEvent, useMemo, useState } from 'react';
+
+type Message = { id: string; userId: string; text: string; createdAt: string };
+
+type Session = { id: string; provider: string; createdAt: string };
+
+const endpoints = {
+  auth: process.env.NEXT_PUBLIC_AUTH_URL || 'http://localhost:4101',
+  squads: process.env.NEXT_PUBLIC_SQUADS_URL || 'http://localhost:4102',
+  voice: process.env.NEXT_PUBLIC_VOICE_URL || 'http://localhost:4103',
+  realtime: process.env.NEXT_PUBLIC_REALTIME_URL || 'http://localhost:4104'
+};
+
+export function PhaseAConsole() {
+  const [userId, setUserId] = useState('');
+  const [session, setSession] = useState<Session | null>(null);
+  const [squadId, setSquadId] = useState('');
+  const [voiceToken, setVoiceToken] = useState('');
+  const [messages, setMessages] = useState<Message[]>([]);
+  const [chatText, setChatText] = useState('');
+
+  const roomId = useMemo(() => squadId || 'lobby', [squadId]);
+
+  const signIn = async () => {
+    const start = await fetch(`${endpoints.auth}/v1/auth/oauth/start`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ provider: 'google', userId: userId || undefined })
+    }).then((r) => r.json());
+
+    setUserId(start.userId);
+    setSession(start.session);
+
+    await fetch(`${endpoints.auth}/v1/auth/oauth/callback`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ userId: start.userId, provider: 'google', code: 'dev-code' })
+    });
+  };
+
+  const partyUp = async () => {
+    if (!userId) return;
+    const response = await fetch(`${endpoints.squads}/v1/squads/party-up`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ userId, game: 'Valorant', mode: 'Ranked' })
+    }).then((r) => r.json());
+
+    setSquadId(response.squad.id);
+
+    const voice = await fetch(`${endpoints.voice}/v1/voice/rooms/${response.squad.id}/token`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ userId })
+    }).then((r) => r.json());
+
+    setVoiceToken(voice.token);
+  };
+
+  const connectRoom = () => {
+    const stream = new EventSource(`${endpoints.realtime}/v1/realtime/rooms/${roomId}/stream`);
+    stream.onmessage = (event) => {
+      const parsed = JSON.parse(event.data);
+      if (parsed.type === 'bootstrap') setMessages(parsed.messages);
+      if (parsed.type === 'message') setMessages((prev) => [...prev, parsed.message]);
+    };
+  };
+
+  const sendMessage = async (e: FormEvent) => {
+    e.preventDefault();
+    if (!chatText || !userId) return;
+    await fetch(`${endpoints.realtime}/v1/realtime/rooms/${roomId}/messages`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ userId, text: chatText })
+    });
+    setChatText('');
+  };
+
+  return (
+    <section className="grid" style={{ gap: '1rem' }}>
+      <div className="card">
+        <h3>1) OAuth sign-in (dev mock)</h3>
+        <button className="btn btnPrimary" type="button" onClick={signIn}>Sign in with Google</button>
+        <p>User: {userId || 'Not signed in'}</p>
+        <p>Session: {session?.id || 'None'}</p>
+      </div>
+
+      <div className="card">
+        <h3>2) Party Up + voice token</h3>
+        <button className="btn btnPrimary" type="button" onClick={partyUp} disabled={!userId}>Create Ranked Squad</button>
+        <p>Squad ID: {squadId || 'None'}</p>
+        <p>Voice token preview: {voiceToken ? `${voiceToken.slice(0, 36)}...` : 'None'}</p>
+      </div>
+
+      <div className="card">
+        <h3>3) Realtime room chat (SSE)</h3>
+        <button className="btn btnSecondary" type="button" onClick={connectRoom}>Connect room stream</button>
+        <form onSubmit={sendMessage} style={{ marginTop: '.8rem', display: 'flex', gap: '.6rem' }}>
+          <input
+            value={chatText}
+            onChange={(e) => setChatText(e.target.value)}
+            placeholder="Send team comms..."
+            style={{ flex: 1, borderRadius: '.5rem', border: '1px solid #ffffff35', padding: '.55rem .7rem', background: 'transparent', color: 'inherit' }}
+          />
+          <button className="btn btnPrimary" type="submit">Send</button>
+        </form>
+        <div style={{ marginTop: '.8rem' }}>
+          {messages.map((msg) => (
+            <p key={msg.id}><strong>{msg.userId}</strong>: {msg.text}</p>
+          ))}
+        </div>
+      </div>
+    </section>
+  );
+}
