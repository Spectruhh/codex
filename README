@@ -0,0 +1,22 @@
+const store = {
+  sessionsByUser: new Map(),
+  squadsById: new Map(),
+  roomMessages: new Map(),
+  roomStreams: new Map()
+};
+
+const getMessages = (roomId) => {
+  if (!store.roomMessages.has(roomId)) {
+    store.roomMessages.set(roomId, []);
+  }
+  return store.roomMessages.get(roomId);
+};
+
+const getStreams = (roomId) => {
+  if (!store.roomStreams.has(roomId)) {
+    store.roomStreams.set(roomId, new Set());
+  }
+  return store.roomStreams.get(roomId);
+};
+
+module.exports = { store, getMessages, getStreams };
diff --git a/services/lib/domain.js b/services/lib/domain.js
new file mode 100644
index 0000000000000000000000000000000000000000..eb88dd0f0e96743f3e6930438f971570344f997e
--- /dev/null
+++ b/services/lib/domain.js
@@ -0,0 +1,47 @@
+const crypto = require('crypto');
+
+const nowIso = () => new Date().toISOString();
+
+const createSession = ({ userId, provider }) => ({
+  id: crypto.randomUUID(),
+  userId,
+  provider,
+  createdAt: nowIso(),
+  device: 'web',
+  ip: '127.0.0.1'
+});
+
+const createSquad = ({ userId, game, mode, ttlMinutes = 180 }) => {
+  const expiresAt = new Date(Date.now() + ttlMinutes * 60_000).toISOString();
+  return {
+    id: `sqd_${crypto.randomUUID().slice(0, 8)}`,
+    game,
+    mode,
+    expiresAt,
+    createdAt: nowIso(),
+    members: [userId],
+    status: 'active'
+  };
+};
+
+const joinSquad = (squad, userId) => {
+  if (!squad.members.includes(userId)) squad.members.push(userId);
+  return squad;
+};
+
+const disbandSquad = (squad) => ({ ...squad, status: 'disbanded', disbandedAt: nowIso() });
+
+const signVoiceToken = ({ roomId, userId, secret, ttlSeconds = 600 }) => {
+  const exp = Math.floor(Date.now() / 1000) + ttlSeconds;
+  const payload = Buffer.from(JSON.stringify({ roomId, userId, exp })).toString('base64url');
+  const signature = crypto.createHmac('sha256', secret).update(payload).digest('base64url');
+  return `${payload}.${signature}`;
+};
+
+module.exports = {
+  createSession,
+  createSquad,
+  joinSquad,
+  disbandSquad,
+  signVoiceToken
+};
diff --git a/services/realtime/server.js b/services/realtime/server.js
new file mode 100644
index 0000000000000000000000000000000000000000..7186d21b702733eb6d959b94bec7075f61ee4cce
--- /dev/null
+++ b/services/realtime/server.js
@@ -0,0 +1,61 @@
+const http = require('http');
+const { json, notFound, readBody, handleCorsPreflight } = require('../common/http');
+const { getMessages, getStreams } = require('../common/store');
+
+const port = Number(process.env.REALTIME_PORT || 4104);
+
+const pushEvent = (roomId, event) => {
+  const clients = getStreams(roomId);
+  for (const res of clients) {
+    res.write(`data: ${JSON.stringify(event)}\n\n`);
+  }
+};
+
+const server = http.createServer(async (req, res) => {
+  if (handleCorsPreflight(req, res)) return;
+
+  if (req.method === 'GET' && req.url.startsWith('/v1/realtime/rooms/') && req.url.endsWith('/stream')) {
+    const roomId = req.url.split('/')[4];
+    res.writeHead(200, {
+      'Content-Type': 'text/event-stream',
+      'Cache-Control': 'no-cache',
+      Connection: 'keep-alive',
+      'Access-Control-Allow-Origin': '*'
+    });
+    const streams = getStreams(roomId);
+    streams.add(res);
+
+    res.write(`data: ${JSON.stringify({ type: 'bootstrap', messages: getMessages(roomId) })}\n\n`);
+    req.on('close', () => streams.delete(res));
+    return;
+  }
+
+  if (req.method === 'POST' && req.url.startsWith('/v1/realtime/rooms/') && req.url.endsWith('/messages')) {
+    const roomId = req.url.split('/')[4];
+    const body = await readBody(req);
+    if (!body.userId || !body.text) return json(res, 400, { error: 'userId_text_required' });
+
+    const message = {
+      id: `msg_${Math.random().toString(36).slice(2, 8)}`,
+      userId: body.userId,
+      text: String(body.text).slice(0, 800),
+      createdAt: new Date().toISOString()
+    };
+    const messages = getMessages(roomId);
+    messages.push(message);
+    pushEvent(roomId, { type: 'message', message });
+    return json(res, 201, { message });
+  }
+
+  if (req.method === 'GET' && req.url.startsWith('/v1/realtime/rooms/') && req.url.endsWith('/messages')) {
+    const roomId = req.url.split('/')[4];
+    return json(res, 200, { messages: getMessages(roomId) });
+  }
+
+  return notFound(res);
+});
+
+server.listen(port, () => {
+  // eslint-disable-next-line no-console
+  console.log(`[realtime-service] running on :${port}`);
+});
diff --git a/services/run-all.js b/services/run-all.js
new file mode 100644
