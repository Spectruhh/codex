+openapi: 3.1.0
+info:
+  title: Voxra API
+  version: 0.1.0
+  description: Core API contract for auth, squads, communities, and moderation.
+servers:
+  - url: https://api.voxra.gg
+paths:
+  /v1/auth/oauth/start:
+    post:
+      summary: Start OAuth flow
+      responses:
+        '200':
+          description: OAuth URL
+  /v1/squads/party-up:
+    post:
+      summary: Create or join temporary squad
+      responses:
+        '200':
+          description: Squad details
+  /v1/voice/rooms/{roomId}/token:
+    post:
+      summary: Issue voice session token
+      parameters:
+        - name: roomId
+          in: path
+          required: true
+          schema: { type: string }
+      responses:
+        '200':
+          description: Ephemeral WebRTC auth token
+  /v1/moderation/reports:
+    post:
+      summary: Submit realtime abuse report
+      responses:
+        '201':
+          description: Report accepted
+  /v1/admin/kpis:
+    get:
+      summary: Admin analytics snapshot
+      responses:
+        '200':
+          description: KPI payload
+components:
+  schemas:
+    Squad:
+      type: object
+      properties:
+        id: { type: string }
+        mode: { type: string }
+        expiresAt: { type: string, format: date-time }
+    KPI:
+      type: object
+      properties:
+        dau: { type: integer }
+        voiceUptime: { type: number }
+        retentionD7: { type: number }
+        mrr: { type: number }
