@@ -0,0 +1,18 @@
+const { spawn } = require('child_process');
+
+const services = [
+  'services/auth/server.js',
+  'services/squads/server.js',
+  'services/voice-token/server.js',
+  'services/realtime/server.js'
+];
+
+const children = services.map((entry) => spawn(process.execPath, [entry], { stdio: 'inherit' }));
+
+const shutdown = () => {
+  for (const child of children) child.kill('SIGTERM');
+  process.exit(0);
+};
+
+process.on('SIGINT', shutdown);
+process.on('SIGTERM', shutdown);
diff --git a/services/squads/server.js b/services/squads/server.js
new file mode 100644
index 0000000000000000000000000000000000000000..83c1530e4d0d4a284206e53ea50b78ed9fa31ff8
--- /dev/null
+++ b/services/squads/server.js
@@ -0,0 +1,53 @@
+const http = require('http');
+const { json, notFound, readBody, handleCorsPreflight } = require('../common/http');
+const { store } = require('../common/store');
+const { createSquad, joinSquad, disbandSquad } = require('../lib/domain');
+
+const port = Number(process.env.SQUADS_PORT || 4102);
+
+const server = http.createServer(async (req, res) => {
+  if (handleCorsPreflight(req, res)) return;
+
+  if (req.method === 'POST' && req.url === '/v1/squads/party-up') {
+    const body = await readBody(req);
+    if (!body.userId || !body.game || !body.mode) {
+      return json(res, 400, { error: 'userId_game_mode_required' });
+    }
+
+    const squad = createSquad({ userId: body.userId, game: body.game, mode: body.mode });
+    store.squadsById.set(squad.id, squad);
+    return json(res, 200, { squad });
+  }
+
+  if (req.method === 'POST' && req.url.startsWith('/v1/squads/') && req.url.endsWith('/join')) {
+    const parts = req.url.split('/');
+    const squadId = parts[3];
+    const body = await readBody(req);
+    const squad = store.squadsById.get(squadId);
+    if (!squad) return json(res, 404, { error: 'squad_not_found' });
+    joinSquad(squad, body.userId);
+    return json(res, 200, { squad });
+  }
+
+  if (req.method === 'POST' && req.url.startsWith('/v1/squads/') && req.url.endsWith('/disband')) {
+    const parts = req.url.split('/');
+    const squadId = parts[3];
+    const squad = store.squadsById.get(squadId);
+    if (!squad) return json(res, 404, { error: 'squad_not_found' });
+    const next = disbandSquad(squad);
+    store.squadsById.set(squadId, next);
+    return json(res, 200, { squad: next });
+  }
+
+  if (req.method === 'GET' && req.url.startsWith('/v1/squads/')) {
+    const squadId = req.url.split('/')[3];
+    return json(res, 200, { squad: store.squadsById.get(squadId) || null });
+  }
+
+  return notFound(res);
+});
+
+server.listen(port, () => {
+  // eslint-disable-next-line no-console
+  console.log(`[squad-service] running on :${port}`);
+});
diff --git a/services/voice-token/server.js b/services/voice-token/server.js
