diff --git a/services/auth/server.js b/services/auth/server.js
new file mode 100644
index 0000000000000000000000000000000000000000..9f197c80003bc1ba75e2c52191f4cfdbbefa7674
--- /dev/null
+++ b/services/auth/server.js
@@ -0,0 +1,48 @@
+const http = require('http');
+const { json, notFound, readBody, handleCorsPreflight } = require('../common/http');
+const { store } = require('../common/store');
+const { createSession } = require('../lib/domain');
+
+const port = Number(process.env.AUTH_PORT || 4101);
+
+const server = http.createServer(async (req, res) => {
+  if (handleCorsPreflight(req, res)) return;
+  if (req.method === 'POST' && req.url === '/v1/auth/oauth/start') {
+    const body = await readBody(req);
+    const provider = body.provider || 'google';
+    const userId = body.userId || `usr_${Math.random().toString(36).slice(2, 8)}`;
+    const session = createSession({ userId, provider });
+    const sessions = store.sessionsByUser.get(userId) || [];
+    sessions.push(session);
+    store.sessionsByUser.set(userId, sessions);
+    return json(res, 200, {
+      authUrl: `https://auth.voxra.gg/${provider}/authorize?user=${userId}`,
+      userId,
+      session
+    });
+  }
+
+  if (req.method === 'POST' && req.url === '/v1/auth/oauth/callback') {
+    const body = await readBody(req);
+    const userId = body.userId;
+    if (!userId) return json(res, 400, { error: 'userId_required' });
+    const sessions = store.sessionsByUser.get(userId) || [];
+    return json(res, 200, {
+      accessToken: `voxra_${Buffer.from(`${userId}:${Date.now()}`).toString('base64url')}`,
+      user: { id: userId, gamerTag: `VXR-${userId.slice(-4)}` },
+      sessions
+    });
+  }
+
+  if (req.method === 'GET' && req.url.startsWith('/v1/auth/sessions/')) {
+    const userId = req.url.split('/').pop();
+    return json(res, 200, { userId, sessions: store.sessionsByUser.get(userId) || [] });
+  }
+
+  return notFound(res);
+});
+
+server.listen(port, () => {
+  // eslint-disable-next-line no-console
+  console.log(`[auth-service] running on :${port}`);
+});
diff --git a/services/common/http.js b/services/common/http.js
new file mode 100644
index 0000000000000000000000000000000000000000..2c230fb5396bea784b500fd7ed4b9e7ebb69170a
--- /dev/null
+++ b/services/common/http.js
@@ -0,0 +1,37 @@
+const json = (res, status, payload) => {
+  res.writeHead(status, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Access-Control-Allow-Origin': '*',
+    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
+    'Access-Control-Allow-Headers': 'Content-Type, Authorization'
+  });
+  res.end(JSON.stringify(payload));
+};
+
+const notFound = (res) => json(res, 404, { error: 'not_found' });
+
+const readBody = async (req) => {
+  const chunks = [];
+  for await (const chunk of req) chunks.push(chunk);
+  if (!chunks.length) return {};
+  const raw = Buffer.concat(chunks).toString('utf8');
+  return raw ? JSON.parse(raw) : {};
+};
+
+const handleCorsPreflight = (req, res) => {
+  if (req.method !== 'OPTIONS') return false;
+  res.writeHead(204, {
+    'Access-Control-Allow-Origin': '*',
+    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
+    'Access-Control-Allow-Headers': 'Content-Type, Authorization'
+  });
+  res.end();
+  return true;
+};
+
+module.exports = {
+  json,
+  notFound,
+  readBody,
+  handleCorsPreflight
+};
diff --git a/services/common/store.js b/services/common/store.js
new file mode 100644
index 0000000000000000000000000000000000000000..3abad97f47e070242f7e07f9d260f2f75279c4ac
