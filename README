+const http = require('http');
+const { json, notFound, readBody, handleCorsPreflight } = require('../common/http');
+const { signVoiceToken } = require('../lib/domain');
+
+const port = Number(process.env.VOICE_PORT || 4103);
+const secret = process.env.VOICE_TOKEN_SECRET || 'voxra-dev-secret';
+
+const server = http.createServer(async (req, res) => {
+  if (handleCorsPreflight(req, res)) return;
+
+  if (req.method === 'POST' && req.url.startsWith('/v1/voice/rooms/') && req.url.endsWith('/token')) {
+    const parts = req.url.split('/');
+    const roomId = parts[4];
+    const body = await readBody(req);
+    if (!body.userId) return json(res, 400, { error: 'userId_required' });
+    const token = signVoiceToken({ roomId, userId: body.userId, secret });
+    return json(res, 200, { roomId, token, provider: 'webrtc', expiresIn: 600 });
+  }
+
+  return notFound(res);
+});
+
+server.listen(port, () => {
+  // eslint-disable-next-line no-console
+  console.log(`[voice-token-service] running on :${port}`);
+});
