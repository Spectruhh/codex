@@ -0,0 +1,22 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createSquad, joinSquad, signVoiceToken } = require('../services/lib/domain');
+
+test('createSquad creates active squad with member', () => {
+  const squad = createSquad({ userId: 'usr_1', game: 'Valorant', mode: 'Ranked' });
+  assert.equal(squad.status, 'active');
+  assert.deepEqual(squad.members, ['usr_1']);
+  assert.equal(squad.game, 'Valorant');
+});
+
+test('joinSquad appends distinct members', () => {
+  const squad = createSquad({ userId: 'usr_1', game: 'Apex', mode: 'Trios' });
+  joinSquad(squad, 'usr_2');
+  joinSquad(squad, 'usr_2');
+  assert.deepEqual(squad.members, ['usr_1', 'usr_2']);
+});
+
+test('signVoiceToken returns signed payload.signature', () => {
+  const token = signVoiceToken({ roomId: 'room1', userId: 'usr_1', secret: 's3cr3t' });
+  assert.equal(token.split('.').length, 2);
+});
